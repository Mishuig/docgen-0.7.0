<Window x:Class="DocumentGenerator.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentGenerator"
        Title="Docugen"
        Style="{StaticResource DialogWindowStyle}"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner">
    <StackPanel>
        <Grid Margin="28,24,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="BadgeBorder" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,16,0">
                <local:FluentIcon x:Name="BadgeIcon" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMain}"/>
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Grid>
        <Border Background="{StaticResource FooterBg}" BorderBrush="{StaticResource Hairline}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Скасувати" Click="Cancel_Click" IsCancel="True"
                        MinWidth="110" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Click="Confirm_Click" MinWidth="110">
                    <StackPanel Orientation="Horizontal">
                        <local:FluentIcon x:Name="ConfirmIcon" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ConfirmLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
