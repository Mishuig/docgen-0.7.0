<Window x:Class="DocumentGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DocumentGenerator"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Docugen" Height="820" Width="1280"
        MinHeight="60" MinWidth="60"
        WindowStartupLocation="CenterScreen"
        Icon="App.ico"
        Background="{StaticResource Mica}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="{DynamicResource FsBase}"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="LibraryItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{DynamicResource ItemPad}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" Margin="3,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FooterBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок вікна: оригінальне лого + назва + кнопки керування вікном -->
        <Grid x:Name="HeaderBar" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="Logo.png" Height="30" Margin="14,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
            <TextBlock Grid.Column="1" Text="Docugen" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Згорнути" AutomationProperties.Name="Згорнути">
                    <local:FluentIcon Data="{StaticResource IconMinimize}" Width="14" Height="14"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Розгорнути" AutomationProperties.Name="Розгорнути">
                    <local:FluentIcon x:Name="MaxIcon" Data="{StaticResource IconMaximize}" Width="14" Height="14"/>
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Закрити" AutomationProperties.Name="Закрити">
                    <local:FluentIcon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Тіло: розташування трьох карток задається в коді (MainWindow.Responsive.cs) -->
        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="{DynamicResource BodyMargin}">

            <!-- Бібліотека шаблонів -->
            <Border x:Name="LibraryCard" Background="{StaticResource CardBg}" CornerRadius="8"
                    Padding="{DynamicResource CardPad}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DockPanel>
                            <local:FluentIcon DockPanel.Dock="Left" Data="{StaticResource IconLibrary}" Width="16" Height="16"
                                              Margin="0,0,8,0" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                            <local:FitTextBlock Text="Бібліотека шаблонів" FontSize="{DynamicResource FsHead}"
                                                FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        </DockPanel>
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="SearchBox" Padding="34,6,10,6" MinHeight="32"
                                     TextChanged="SearchBox_TextChanged" Tag="search"
                                     AutomationProperties.Name="Пошук шаблонів"/>
                            <local:FluentIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Margin="10,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="Пошук шаблонів" Margin="34,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextMuted}" FontSize="{DynamicResource FsSmall}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="TemplatesList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource LibraryItemStyle}"
                             SelectionChanged="TemplatesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <local:FluentIcon DockPanel.Dock="Left" Data="{StaticResource IconDoc}" Width="18" Height="18"
                                                      Margin="6,0,10,0" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                            ToolTip="Перейменувати шаблон"
                                            AutomationProperties.Name="Перейменувати шаблон"
                                            Click="TemplateRenamePencil_Click"
                                            Tag="{Binding}"
                                            Foreground="{StaticResource Accent}">
                                        <local:FluentIcon Data="{StaticResource IconPencil}" Width="16" Height="16"/>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <local:FitTextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        <local:FitTextBlock Text="{Binding Category}" FontSize="{DynamicResource FsTiny}" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Центральна форма -->
            <Border x:Name="FormCard" Background="{StaticResource CardBg}" CornerRadius="8"
                    Padding="{DynamicResource FormPad}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <local:FitTextBlock x:Name="SelectedTemplateTitle" Text="Оберіть шаблон"
                                            FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <Border x:Name="TemplateInfoChip" Background="{StaticResource Mint}" CornerRadius="10" Padding="8,2"
                                HorizontalAlignment="Left" Margin="0,6,0,8" Visibility="Collapsed">
                            <local:FitTextBlock x:Name="TemplateInfo" Text="" Foreground="#0B4A5C"
                                                FontSize="{DynamicResource FsSmall}"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource Hairline}" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FieldsPanel"
                                    AllowDrop="True"
                                    Drop="FieldsPanel_Drop"
                                    DragOver="FieldsPanel_DragOver"/>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="{DynamicResource BtnGridMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:FitButton Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="{DynamicResource BtnGap}"
                                         Icon="{StaticResource IconFolder}" Text="Відкрити шаблон"
                                         Click="OpenTemplate_Click" Style="{StaticResource GhostButton}"/>
                        <local:FitButton Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Margin="{DynamicResource BtnGap}"
                                         Icon="{StaticResource IconEraser}" Text="Очистити поля"
                                         Click="ClearFields_Click" Style="{StaticResource GhostButton}"/>
                        <local:FitButton Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="{DynamicResource BtnGap}"
                                         Icon="{StaticResource IconEye}" Text="Перегляд"
                                         Click="Preview_Click" Style="{StaticResource GhostButton}"/>
                        <local:FitButton Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Margin="{DynamicResource BtnGap}"
                                         Icon="{StaticResource IconSave}" Text="Зберегти документ"
                                         Click="Generate_Click" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Дії та керування -->
            <Border x:Name="ActionsCard" Background="{StaticResource CardBg}" CornerRadius="8"
                    Padding="{DynamicResource CardPad}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <DockPanel>
                    <local:FitTextBlock x:Name="ActionsTitle" DockPanel.Dock="Top" Text="Дії та Управління"
                                        FontSize="{DynamicResource FsHead}" FontWeight="SemiBold"
                                        Foreground="{StaticResource TextMain}" Margin="0,0,0,10"/>
                    <UniformGrid x:Name="ActionsGrid" Columns="1" VerticalAlignment="Top">
                        <local:FitButton Margin="{DynamicResource BtnGap}" AlignLeft="True"
                                         Icon="{StaticResource IconImport}" Text="Імпортувати DOCX"
                                         Click="ImportTemplate_Click" Style="{StaticResource PrimaryButton}"/>
                        <local:FitButton Margin="{DynamicResource BtnGap}" AlignLeft="True"
                                         Icon="{StaticResource IconBackup}" Text="Резервна копія"
                                         Click="Backup_Click" Style="{StaticResource GhostButton}"/>
                        <local:FitButton Margin="{DynamicResource BtnGap}" AlignLeft="True"
                                         Icon="{StaticResource IconRefresh}" Text="Оновити"
                                         Click="Refresh_Click" Style="{StaticResource GhostButton}"/>
                        <local:FitButton Margin="{DynamicResource BtnGap}" AlignLeft="True"
                                         Icon="{StaticResource IconTrash}" Text="Видалити шаблон"
                                         Click="Delete_Click" Style="{StaticResource DangerButton}"/>
                    </UniformGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Ультракомпактний режим: вміщається лише лого -->
        <Image x:Name="CompactLogo" Grid.Row="1" Source="Logo.png" Margin="6" Stretch="Uniform"
               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
