<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:DocumentGenerator">

    <!-- ===== Палітра (береться з лого) ===== -->
    <SolidColorBrush x:Key="Accent" Color="#0E6178"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D7590"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#0A4F63"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E3F4EE"/>
    <SolidColorBrush x:Key="Mint" Color="#D5F0E6"/>
    <SolidColorBrush x:Key="MintBorder" Color="#A6D5C4"/>
    <SolidColorBrush x:Key="Mica" Color="#EEF4F4"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#D9E6E6"/>
    <SolidColorBrush x:Key="FooterBg" Color="#F4FAF8"/>
    <SolidColorBrush x:Key="Hairline" Color="#DBE8E5"/>
    <SolidColorBrush x:Key="TextMain" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#4A5A5A"/>
    <SolidColorBrush x:Key="DangerFg" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEB"/>
    <SolidColorBrush x:Key="InputBg" Color="#FBFBFB"/>
    <SolidColorBrush x:Key="InputBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="InputBottom" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#D5E0E0"/>

    <!-- ===== Типові розміри (MainWindow перевизначає їх у коді для адаптивності) ===== -->
    <sys:Double x:Key="FsTitle">18</sys:Double>
    <sys:Double x:Key="FsHead">14</sys:Double>
    <sys:Double x:Key="FsBase">13</sys:Double>
    <sys:Double x:Key="FsSmall">12</sys:Double>
    <sys:Double x:Key="FsTiny">11</sys:Double>
    <sys:Double x:Key="BtnH">36</sys:Double>
    <sys:Double x:Key="IconSize">28</sys:Double>
    <sys:Double x:Key="LogoH">28</sys:Double>
    <sys:Double x:Key="InputMinH">36</sys:Double>
    <sys:Double x:Key="InputMinHMulti">72</sys:Double>
    <Thickness x:Key="BtnPad">14,8,14,8</Thickness>
    <Thickness x:Key="BtnGap">4</Thickness>
    <Thickness x:Key="BtnGridMargin">-4,6,-4,-4</Thickness>
    <Thickness x:Key="InputPad">10,8,10,8</Thickness>
    <Thickness x:Key="ItemPad">12,10,12,10</Thickness>
    <Thickness x:Key="CardPad">16</Thickness>
    <Thickness x:Key="FormPad">20</Thickness>
    <Thickness x:Key="BodyMargin">12,4,12,12</Thickness>
    <Thickness x:Key="HeaderPad">12,0,12,0</Thickness>
    <Thickness x:Key="FieldMargin">0,0,0,12</Thickness>

    <!-- ===== Іконки (лінійні, сітка 20x20) ===== -->
    <Geometry x:Key="IconLibrary">M3,3 H9 V9 H3 Z M11,3 H17 V9 H11 Z M3,11 H9 V17 H3 Z M11,11 H17 V17 H11 Z</Geometry>
    <Geometry x:Key="IconSearch">M4,9 A5,5 0 1 0 14,9 A5,5 0 1 0 4,9 Z M13,13 L17,17</Geometry>
    <Geometry x:Key="IconDoc">M5,2.5 H11 L15,6.5 V17 H5 Z M11,2.5 V6.5 H15</Geometry>
    <Geometry x:Key="IconPencil">M13.5,3.5 L16.5,6.5 L7,16 H4 V13 Z</Geometry>
    <Geometry x:Key="IconImport">M10,3 V12 M6.5,8.5 L10,12 L13.5,8.5 M3.5,14 V16.5 H16.5 V14</Geometry>
    <Geometry x:Key="IconBackup">M6,15 A3.5,3.5 0 0 1 5.5,8 A4.5,4.5 0 0 1 14,7.5 A3.8,3.8 0 0 1 14,15 Z</Geometry>
    <Geometry x:Key="IconRefresh">M16,10 A6,6 0 1 1 14,5.5 M16,3.5 V6.5 H13</Geometry>
    <Geometry x:Key="IconTrash">M4,5.5 H16 M8,5.5 V4 H12 V5.5 M5.5,5.5 L6.2,16 H13.8 L14.5,5.5 M8.5,9 V13.5 M11.5,9 V13.5</Geometry>
    <Geometry x:Key="IconFolder">M2.5,15.5 V5 H7.5 L9,6.8 H17.5 V15.5 Z</Geometry>
    <Geometry x:Key="IconEraser">M11,4 L16,9 L10,15 H6.5 L4,12.5 Z M8,7 L13,12 M9,15 H16</Geometry>
    <Geometry x:Key="IconEye">M2,10 C2,10 5,4.5 10,4.5 C15,4.5 18,10 18,10 C18,10 15,15.5 10,15.5 C5,15.5 2,10 2,10 Z M12.2,10 A2.2,2.2 0 1 0 7.8,10 A2.2,2.2 0 1 0 12.2,10 Z</Geometry>
    <Geometry x:Key="IconSave">M4,3.5 H13 L16,6.5 V16.5 H4 Z M7,3.5 V7.5 H12 V3.5 M7,16.5 V11.5 H13 V16.5</Geometry>
    <Geometry x:Key="IconChevronUp">M5,12 L10,7 L15,12</Geometry>
    <Geometry x:Key="IconChevronDown">M5,8 L10,13 L15,8</Geometry>
    <Geometry x:Key="IconChevronRight">M8,5 L13,10 L8,15</Geometry>
    <Geometry x:Key="IconGrip">M7.5,5 H7.6 M12.5,5 H12.6 M7.5,10 H7.6 M12.5,10 H12.6 M7.5,15 H7.6 M12.5,15 H12.6</Geometry>
    <Geometry x:Key="IconClose">M4.5,4.5 L15.5,15.5 M15.5,4.5 L4.5,15.5</Geometry>
    <Geometry x:Key="IconMinimize">M4,10 H16</Geometry>
    <Geometry x:Key="IconMaximize">M5,5 H15 V15 H5 Z</Geometry>
    <Geometry x:Key="IconRestore">M7.5,7.5 H15 V15 H7.5 Z M5,12.5 V5 H12.5</Geometry>
    <Geometry x:Key="IconCheck">M4.5,10.5 L8.5,14.5 L15.5,6</Geometry>

    <!-- ===== Індикатор фокусу клавіатури ===== -->
    <Style x:Key="FluentFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="6" RadiusY="6" IsHitTestVisible="False" SnapsToDevicePixels="True"
                               Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Шаблони кнопок ===== -->
    <ControlTemplate x:Key="LightButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="Overlay" CornerRadius="4" Background="#140E6178" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="#260E6178"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="DangerLightButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="Overlay" CornerRadius="4" Background="#14C42B1C" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Background" Value="#26C42B1C"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="FilledButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <Border x:Name="Overlay" CornerRadius="4" Background="#26FFFFFF" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Background" Value="#33000000"/>
                <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===== Кнопки ===== -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="{DynamicResource BtnPad}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
        <Setter Property="Height" Value="{DynamicResource BtnH}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Template" Value="{StaticResource LightButtonTemplate}"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template" Value="{StaticResource FilledButtonTemplate}"/>
    </Style>
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource DangerFg}"/>
        <Setter Property="Template" Value="{StaticResource DangerLightButtonTemplate}"/>
    </Style>
    <Style x:Key="DangerSolidButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerFg}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template" Value="{StaticResource FilledButtonTemplate}"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinHeight" Value="{DynamicResource IconSize}"/>
        <Setter Property="MinWidth" Value="{DynamicResource IconSize}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DFF1EC"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CDE8E0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Кнопки заголовка вікна ===== -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCE9E9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#C8DADA"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#A82619"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Поле вводу: Fluent (нижня лінія, при фокусі акцентна) ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="{DynamicResource InputPad}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBase}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource InputBg}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                                Background="{StaticResource InputBottom}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Underline" Property="Height" Value="2"/>
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Картки вибору у діалозі збереження ===== -->
    <Style x:Key="OptionCardButton" TargetType="Button">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FooterBg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MintBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OptionCardSelectedButton" TargetType="Button" BasedOn="{StaticResource OptionCardButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Mint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Діалогові вікна: заголовок з лого + кнопка закриття ===== -->
    <Style x:Key="DialogWindowStyle" TargetType="Window">
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                                    CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#CFDCDC" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Mica}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Image Source="pack://application:,,,/Logo.png" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{TemplateBinding Title}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButton}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            ToolTip="Закрити" AutomationProperties.Name="Закрити">
                                        <local:FluentIcon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
